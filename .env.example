# Environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_workflow
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/agent_workflow
SQLITE_DB_PATH=./data/dev.db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=fake
DEFAULT_MODEL_NAME=claude-3-5-sonnet-20241022

# MCP Servers (URLs or stdio command paths)
CRM_MCP_URL=http://localhost:8001/mcp
TICKETING_MCP_URL=http://localhost:8002/mcp
EMAIL_MCP_URL=http://localhost:8003/mcp
PAYMENTS_MCP_URL=http://localhost:8004/mcp

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-workflow-platform
PROMETHEUS_METRICS_ENABLED=true
